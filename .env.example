# ===== PharmaGuard AI — متغيرات البيئة =====
# تُضاف من: AppJet → Settings → Environment variables (أو ملف .env محليًا للتطوير).
# لا تُرفع القيم الحقيقية إلى Git أبدًا.

# مشروع Supabase الموجود (لا تُنشئ مشروعًا جديدًا)
SUPABASE_URL=https://ewsqllummpysxovtuqad.supabase.co

# المفتاح العام (anon / publishable) — يُستخدم في المتصفح، محمي بـ RLS
SUPABASE_ANON_KEY=

# مفتاح الخدمة (service_role) — سري، يُستخدم على السيرفر فقط ولا يصل للمتصفح
SUPABASE_SERVICE_ROLE_KEY=

# رمز سري تختاره أنت، مطلوب مرة واحدة لإنشاء أول حساب مالك للصيدلية
OWNER_BOOTSTRAP_TOKEN=

# اختياري: منفذ السيرفر (الاستضافة تضبطه تلقائيًا)
# PORT=3000
